# Demo branch environment variables
# Copy this to .env.local when running the demo locally,
# or set NEXT_PUBLIC_DEMO_MODE=true in your deployment environment.

NEXT_PUBLIC_DEMO_MODE=true

# The following are intentionally absent in demo mode:
# GITHUB_TOKEN, GITHUB_OWNER, GITHUB_REPO — writes are intercepted client-side
# SESSION_SECRET — sessions are bypassed entirely

