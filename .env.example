# --- Session & owner access (REQUIRED — the app has no built-in fallback secret) ---
# Random string, 32+ characters. Signs the session cookie.
SESSION_SECRET=
# Random secret, 16+ characters. Only someone who knows this can start a session.
OWNER_ACCESS_KEY=

# --- GitHub storage adapter (production writes) ---
# Fine-grained token limited to THIS repository, with Contents: read & write only.
GITHUB_TOKEN=
GITHUB_OWNER=your-github-username
GITHUB_REPO=mastery-os
# Optional: commit data to a dedicated branch instead of main.
GITHUB_BRANCH=main
